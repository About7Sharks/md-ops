# Docker publishes only to this address. Keep the default for a single-machine install.
MD_OPS_BIND_ADDRESS=127.0.0.1
MD_OPS_PORT=3098
MD_OPS_IMAGE=md-ops:0.1.0

# DNS-rebinding defense. Add only exact hostnames of reviewed reverse proxies.
MD_OPS_TRUSTED_HOSTS=localhost,127.0.0.1,::1

# Mount a narrow, dedicated Markdown directory. Do not mount a home directory or a filesystem root.
# Optional `home` is a logical Markdown path inside that root; it opens in Read view on startup.
MD_OPS_VAULT_PATH=./packages/api/example-vault
MD_OPS_ROOT_ID=demo
MD_OPS_ROOT_LABEL=Demo vault
MD_OPS_ROOT_HOME=Welcome.md

# Keep the bind mount read-only until you intentionally enable editing.
MD_OPS_VAULT_READ_ONLY=true

# The container runs without root. Match the owner of the mounted vault.
MD_OPS_UID=1000
MD_OPS_GID=1000

# To enable writes, set this to true AND set MD_OPS_VAULT_READ_ONLY=false.
# Do that only after you have a tested backup and trust every client.
MD_OPS_ALLOW_MUTATIONS=false
